# ──── Conexión a la base de datos de GAV ────
# Descomentar y ajustar según el motor:
#   PostgreSQL: postgresql+psycopg2://usuario:clave@host:5432/gav
#   MySQL:      mysql+pymysql://usuario:clave@host:3306/gav
#   SQL Server: mssql+pyodbc://usuario:clave@host/gav?driver=ODBC+Driver+17+for+SQL+Server
GAV_DB_URL=

# Consulta SQL (ya apunta a la tabla viaje del esquema real de GAV).
# Solo cambiar si renombraron la tabla o la columna.
# GAV_SQL_VIAJES=SELECT fecha_solicitud, estado_viaje AS estado FROM viaje

# ──── Autenticación ────
# Si se define, toda petición necesita el header: Authorization: Bearer <clave>
# Si se deja vacío o se omite, el servicio queda abierto (desarrollo).
GAV_API_KEY=

# ──── Ruta de artefactos (opcional) ────
# GAV_ARTEFACTOS_DIR=/ruta/personalizada/artefactos
