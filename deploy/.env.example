# Copiar a .env en el servidor:  cp .env.example .env && nano .env
# .env NUNCA se sube a Git (está en .gitignore).

# --- Dominios (DuckDNS) ---
APP_DOMAIN=gav-app.duckdns.org
PRED_DOMAIN=gav-pred.duckdns.org
ACME_EMAIL=tu-correo@tecnologicocomfenalco.edu.co

# --- Azure Database for MySQL (del resumen del script de Azure) ---
DB_HOST=mysql-gav-xxxxxx.mysql.database.azure.com
DB_NAME=gav
DB_USER=gavadmin
# Evitar en la clave:  / @ : # % ? & " y espacios (rompen la URL de conexión de Python)
DB_PASSWORD=cambia-esta-clave

# --- Backend ---
# Generar uno nuevo para producción:  openssl rand -base64 48
JWT_SECRET=
# Clave de Gemini para el chatbot (la misma de secrets.properties en local)
CHATBOT_API_KEY=
# Clave del usuario admin que crea AdminSeeder al primer arranque (usuario: admin)
ADMIN_SEED_PASSWORD=
BACKEND_HEAP=768m
BACKEND_MEM_LIMIT=1200m

# --- prediction-service ---
# Si se define, Flutter debe enviar el mismo valor (PREDICCION_API_KEY en env/prod.json)
PREDICCION_API_KEY=
PREDICTION_MEM_LIMIT=1800m
